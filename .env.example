# Copy to .env.local and fill in. .env.local is gitignored.
GEMINI_API_KEY=

# Optional. The defaults were chosen by probing the free tier, not by model number.
# Newest is not fastest: 3.8 sometimes holds a connection for a minute before a 503.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3-flash-preview

# minimal | low | medium | high. Default is low: it answered in ~7s where default
# thinking took 35-113s and once ran out of output budget before finishing the JSON.
# GEMINI_THINKING=low
